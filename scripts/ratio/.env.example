# Credenziali IMAP per leggere la casella sicuri@atparma.com (SOLA LETTURA).
#
# Non serve creare questo file se le stesse variabili sono gia' presenti in
# ~/formatemp-verifiche/.env (il motore le legge da li' come fallback).
# Copia in .env SOLO se vuoi credenziali dedicate a questo script.

IMAP_HOST=imap.atparma.com
IMAP_PORT=993
STUDIO_MAIL_USER=sicuri@atparma.com
STUDIO_MAIL_PASS=__la_password__
